# Copy this file to .env.local and fill in the values from your Supabase project
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The public URL of your deployed app (used for magic-link redirects and invite links)
# Local dev: http://localhost:3000   |   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
